{
    "name": "horat1us/yii2-console-bootstrap",
    "description": "Yii2 Console Controller Bootstrap",
    "type": "library",
    "require": {
        "yiisoft/yii2": "^2.0.52",
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1",
        "squizlabs/php_codesniffer": "^3.12",
        "horat1us/yii2-asset-free": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Horat1us\\Yii\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horat1us\\Yii\\Console\\Tests\\": "tests/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Horat1us",
            "email": "reclamme@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "scripts": {
        "lint": "phpcs --standard=PSR12 ./src ./tests",
        "phpcbf": "phpcbf --standard=PSR12 ./src ./tests",
        "cover": "phpunit --coverage-clover=coverage.xml",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": false
        }
    }
}
